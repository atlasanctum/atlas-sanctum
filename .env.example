# Atlas Genesis — Frontend Environment
# Copy this file to .env and fill in your values. NEVER commit .env.

# Backend API URL — leave unset in local dev (Vite proxy handles it).
# Set in production, e.g. https://api.atlas-sanctum.earth/api
# Also set BACKEND_URL in Vercel project settings for the vercel.json rewrite.
VITE_API_URL=""
BACKEND_URL="https://your-backend.onrender.com"

VITE_GOOGLE_ANALYTICS_ID=""
VITE_PAYPAL_CLIENT_ID=""
VITE_PAYSTACK_PUBLIC_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_POSTHOG_KEY=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Error reporting
VITE_SENTRY_DSN=""
VITE_ERROR_REPORT_ENDPOINT=""

# Blockchain contract addresses (EVM — Ethereum / Polygon / Sepolia)
# Leave blank in dev to disable on-chain features (mock data used instead)
VITE_CONTRACT_RIU_TOKEN=""
VITE_CONTRACT_IMPACT_NFT=""
VITE_CONTRACT_MARKETPLACE=""
VITE_CONTRACT_PAYMENT_TOKEN=""

# Supabase Edge Function secrets (set via `supabase secrets set`)
# STRIPE_SECRET_KEY=sk_live_...
# COINBASE_COMMERCE_API_KEY=...
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...

# ───────────────────────────────────────────────────────────────────────────────
# AI Services
# ───────────────────────────────────────────────────────────────────────────────

# LLM Providers (set at least one)
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-3-5-sonnet-20241022"

# LLM request timeout (ms)
LLM_REQUEST_TIMEOUT_MS="30000"

# Ethics hard block — set to "true" in production to block non-compliant requests
ETHICS_HARD_BLOCK_ON_VIOLATION="false"

# LangGraph Agent Microservice (services/ai/langgraph/server.py)
AGENT_SERVICE_URL="http://localhost:8001"
AGENT_SERVICE_PORT="8001"
AGENT_SERVICE_SECRET=""  # shared secret between Node.js backend and Python service

# Weaviate Vector Database (Knowledge Commons)
WEAVIATE_URL=""           # e.g. https://your-cluster.weaviate.network
WEAVIATE_API_KEY=""

# Prometheus metrics endpoint protection
METRICS_ALLOWED_IPS="127.0.0.1,::1"
METRICS_AUTH_TOKEN=""
